{
  "name": "voicecoach-v2",
  "version": "1.0.0",
  "description": "Modern desktop sales coaching application with AI-powered document analysis",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run electron:dev\"",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "wait-on tcp:5175 && set NODE_ENV=development&& electron .",
    "electron:pack": "npm run build && electron-builder",
    "test": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^1.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.voicecoach.v2",
    "productName": "VoiceCoach V2",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}

      "common_mistakes": [
        "Mislabeling emotions",
        "Being too direct or blunt"
      ],
      "urgency_level": "high"
    },
    {
      "technique_name": "Calibrated Questions",
      "description": "Ask open-ended How/What questions",
      "when_to_use": [
        {
          "trigger": "That won't work",
          "prospect_says": "That solution won't work for us",
          "coach_prompt": "Ask: 'What would work?'",
          "salesperson_says": "What would work better for your situation?",
          "expected_result": "Prospect reveals ideal solution"
        },
        {
          "trigger": "Price is too high",
          "prospect_says": "The price is way too high for us",
          "coach_prompt": "Ask: 'How can we proceed?'",
          "salesperson_says": "How can we make this work within your budget?",
          "expected_result": "Prospect suggests alternatives"
        },
        {
          "trigger": "I need to think",
          "prospect_says": "I need to think about it",
          "coach_prompt": "Ask: 'What concerns you?'",
          "salesperson_says": "What specifically concerns you most?",
          "expected_result": "Prospect identifies key objections"
        }
      ],
      "implementation": {
        "max_words": 10,
        "action": "Use 'How' or 'What' to shift control",
        "timing": "When facing objections or resistance"
      },
      "common_mistakes": [
        "Using 'Why' questions (feels accusatory)",
        "Asking closed-ended questions"
      ],
      "urgency_level": "critical"
    },
    {

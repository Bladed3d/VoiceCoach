          "salesperson_says": "It sounds like you're skeptical about the ROI",
          "expected_result": "Prospect explains trust issues"
        },
        {
          "trigger": "We can't afford",
          "prospect_says": "We can't afford this right now",
          "coach_prompt": "Label: 'Budget pressure'",
          "salesperson_says": "It seems like budget is a real pressure point",
          "expected_result": "Prospect discusses financial constraints"
        }
      ],
      "implementation": {
        "max_words": 10,
        "action": "Start with 'It seems like' or 'It sounds like'",
        "timing": "When emotions are unspoken but evident"

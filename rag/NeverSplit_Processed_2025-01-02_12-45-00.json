          "prospect_says": "How do you compare to X?",
          "coach_prompt": "Audit: 'You might think they're better'",
          "salesperson_says": "You might think they offer more value",
          "expected_result": "Prospect reveals true priorities"
        },
        {
          "trigger": "Hesitation detected",
          "prospect_says": "I'm not sure about this",
          "coach_prompt": "Audit: 'This probably seems risky'",
          "salesperson_says": "This probably seems like a big risk",
          "expected_result": "Prospect clarifies risk concerns"
        }
      ],
      "implementation": {
        "max_words": 12,
        "action": "List their likely negative thoughts first",
        "timing": "Early in discussion or before bad news"
      },
      "common_mistakes": [
        "Being too negative",
        "Overdoing the audit",
        "Not following up properly"
      ],
      "urgency_level": "medium"
    },
    {

        "action": "Count to 5 before speaking",
        "timing": "After questions or important statements"
      },
      "common_mistakes": [
        "Breaking silence too quickly",
        "Appearing uncomfortable",
        "Using silence too often"
      ],
      "urgency_level": "medium"
    },
    {
      "technique_name": "Black Swan Discovery",
      "description": "Uncover hidden factors",
      "when_to_use": [
        {
          "trigger": "Something feels off",
          "prospect_says": "It's complicated",
          "coach_prompt": "Probe: 'What aren't you telling me?'",
          "salesperson_says": "What else should I know about your situation?",
          "expected_result": "Prospect reveals hidden factor"
        },
        {
          "trigger": "Unexpected resistance",
          "prospect_says": "I just can't do this",
          "coach_prompt": "Dig: 'What's really blocking this?'",
          "salesperson_says": "What's the real challenge here?",
          "expected_result": "Prospect shares true obstacle"
        },
        {
          "trigger": "Timeline urgency",
          "prospect_says": "We need this by Friday",
          "coach_prompt": "Explore: 'What happens Friday?'",
          "salesperson_says": "What specifically happens on Friday?",
          "expected_result": "Prospect reveals critical deadline"
        }
      ],
      "implementation": {
        "max_words": 10,
        "action": "Probe for information they're not sharing",
        "timing": "When something doesn't add up"
      },
      "common_mistakes": [
        "Being too aggressive",
        "Missing subtle cues",
        "Not following up on discoveries"
      ],
      "urgency_level": "critical"
    },

  "techniques": [
    {
      "technique_name": "Mirroring",
      "description": "Repeat last 1-3 words as a question",
      "when_to_use": [
        {
          "trigger": "This seems really expensive",
          "prospect_says": "This seems really expensive for our budget",
          "coach_prompt": "Mirror: 'Really expensive?'",
          "salesperson_says": "Really expensive?",
          "expected_result": "Prospect elaborates on budget concerns"
        },
        {
          "trigger": "I don't think this will work",
          "prospect_says": "I don't think this will work for our team",
          "coach_prompt": "Mirror: 'Work for your team?'",
          "salesperson_says": "Work for your team?",
          "expected_result": "Prospect explains specific concerns"
        },
        {
          "trigger": "We need more time",
          "prospect_says": "We need more time to decide",
          "coach_prompt": "Mirror: 'More time?'",
          "salesperson_says": "More time?",
          "expected_result": "Prospect reveals decision timeline"
        }
      ],
      "implementation": {
        "max_words": 5,
        "action": "Repeat their last 3 words with questioning tone",
        "timing": "Immediately after they finish speaking"
      },
      "common_mistakes": [
        "Mirroring too frequently",
        "Repeating entire sentences",
        "Using flat tone instead of questioning"
      ],
      "urgency_level": "medium"
    },
    {
      "technique_name": "Tactical Empathy",
      "description": "Understand and articulate their emotions",
      "when_to_use": [
        {
          "trigger": "This is frustrating",
          "prospect_says": "This whole process is frustrating",
          "coach_prompt": "Show empathy: 'I hear your frustration'",
          "salesperson_says": "I hear your frustration with this process",
          "expected_result": "Prospect feels understood and opens up"
        },
        {
          "trigger": "I'm worried about",
          "prospect_says": "I'm worried about the implementation",
          "coach_prompt": "Acknowledge: 'Your concern is valid'",
          "salesperson_says": "Your concern about implementation is completely valid",
          "expected_result": "Prospect shares specific worries"
        },
        {
          "trigger": "We've been burned before",
          "prospect_says": "We've been burned by vendors before",
          "coach_prompt": "Empathize: 'Past experiences matter'",
          "salesperson_says": "I understand past experiences have made you cautious",
          "expected_result": "Prospect explains previous failures"
        }
      ],
      "implementation": {
        "max_words": 15,
        "action": "Acknowledge their emotional state directly",
        "timing": "When emotional cues are detected"
      },
      "common_mistakes": [
        "Dismissing their emotions",
        "Moving too quickly to solutions",
        "Fake or insincere empathy"
      ],
      "urgency_level": "high"
    },
    {
      "technique_name": "Labeling",
      "description": "Name emotions to diffuse tension",
      "when_to_use": [
        {
          "trigger": "This doesn't make sense",
          "prospect_says": "This pricing doesn't make any sense",
          "coach_prompt": "Label: 'Seems like you're confused'",
          "salesperson_says": "It seems like the pricing structure is confusing",
          "expected_result": "Prospect clarifies confusion points"
        },
        {
          "trigger": "I don't trust",
          "prospect_says": "I don't trust these numbers",
          "coach_prompt": "Label: 'Sounds like skepticism'",
          "salesperson_says": "It sounds like you're skeptical about the ROI",
          "expected_result": "Prospect explains trust issues"
        },
        {
          "trigger": "We can't afford",
          "prospect_says": "We can't afford this right now",
          "coach_prompt": "Label: 'Seems like budget pressure'",
          "salesperson_says": "It seems like budget is a real pressure point",
          "expected_result": "Prospect discusses financial constraints"
        }
      ],
      "implementation": {
        "max_words": 10,
        "action": "Start with 'It seems like' or 'It sounds like'",
        "timing": "When emotions are evident but unspoken"
      },
      "common_mistakes": [
        "Mislabeling emotions",
        "Being too direct or blunt",
        "Using 'I think you feel' instead of 'It seems'"
      ],
      "urgency_level": "high"
    },
    {
      "technique_name": "Calibrated Questions",
      "description": "Ask open-ended 'How' and 'What' questions",
      "when_to_use": [
        {
          "trigger": "That won't work",
          "prospect_says": "That solution won't work for us",
          "coach_prompt": "Ask: 'What would work better?'",
          "salesperson_says": "What would work better for your situation?",
          "expected_result": "Prospect reveals ideal solution"
        },
        {
          "trigger": "Price is too high",
          "prospect_says": "The price is way too high",
          "coach_prompt": "Ask: 'How can we make this work?'",
          "salesperson_says": "How can we make this work within your budget?",
          "expected_result": "Prospect suggests alternatives"
        },
        {
          "trigger": "I need to think",
          "prospect_says": "I need to think about it",
          "coach_prompt": "Ask: 'What concerns you most?'",
          "salesperson_says": "What specifically concerns you most?",
          "expected_result": "Prospect identifies key objections"
        }
      ],
      "implementation": {
        "max_words": 12,
        "action": "Use 'How' or 'What' to shift control",
        "timing": "When facing objections or resistance"
      },
      "common_mistakes": [
        "Using 'Why' questions (feels accusatory)",
        "Asking closed-ended questions",
        "Multiple questions at once"
      ],
      "urgency_level": "critical"
    },
    {
      "technique_name": "Accusation Audit",
      "description": "Address objections upfront",
      "when_to_use": [
        {
          "trigger": "Starting price discussion",
          "prospect_says": "Let's talk about pricing",
          "coach_prompt": "Audit: 'You probably think we're expensive'",
          "salesperson_says": "You probably think we're expensive",
          "expected_result": "Prospect denies or softens stance"
        },
        {

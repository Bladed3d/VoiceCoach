    {
      "technique_name": "Mirroring",
      "description": "Repeat last 1-3 words as question",
      "when_to_use": [
        {
          "trigger": "This seems really expensive",
          "prospect_says": "This seems really expensive for our budget",
          "coach_prompt": "Mirror: 'Really expensive?'",
          "salesperson_says": "Really expensive?",
          "expected_result": "Prospect elaborates on budget concerns"
        },
        {
          "trigger": "I don't think this will work",
          "prospect_says": "I don't think this will work for our team",
          "coach_prompt": "Mirror: 'Work for your team?'",
          "salesperson_says": "Work for your team?",
          "expected_result": "Prospect explains specific concerns"
        },
        {
          "trigger": "We need more time",
          "prospect_says": "We need more time to make a decision",
          "coach_prompt": "Mirror: 'More time?'",
          "salesperson_says": "More time?",
          "expected_result": "Prospect reveals timeline"
        },
        {
          "trigger": "It's complicated",
          "prospect_says": "It's complicated on our end",
          "coach_prompt": "Mirror: 'Complicated?'",
          "salesperson_says": "Complicated?",
          "expected_result": "Prospect shares complexity details"
        },
        {
          "trigger": "Not the right fit",
          "prospect_says": "This isn't the right fit for us",
          "coach_prompt": "Mirror: 'Right fit?'",
          "salesperson_says": "Right fit?",
          "expected_result": "Prospect defines fit criteria"
        },
        {
          "trigger": "Too many features",
          "prospect_says": "There are too many features we don't need",
          "coach_prompt": "Mirror: 'Don't need?'",
          "salesperson_says": "Don't need?",
          "expected_result": "Prospect lists unnecessary features"
        },
        {
          "trigger": "Implementation concerns",
          "prospect_says": "I have implementation concerns",
          "coach_prompt": "Mirror: 'Implementation concerns?'",
          "salesperson_says": "Implementation concerns?",
          "expected_result": "Prospect details implementation fears"
        }
      ],
      "implementation": {
        "max_words": 5,
        "action": "Repeat their last 3 words with questioning tone",
        "timing": "Immediately after they finish speaking"
      },
      "common_mistakes": [
        "Mirroring too frequently",
        "Repeating entire sentences",
        "Using flat tone instead of questioning"
      ],
      "urgency_level": "medium"
    },
